# ==========================================
# MUSE2API example environment configuration
# Copy to .env to take effect: cp .env.example .env
# ==========================================

# [Required/Optional] Admin and API auth key (starts with m2a_).
# If left empty, a strong random key is generated on first startup and printed to the console log.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Listen address and port (must be 0.0.0.0 inside a Docker container)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public access URL (used by downstream clients and when the admin page builds URLs, e.g. https://api.yourdomain.com)
# If left empty, the admin page uses the host and port the browser is currently accessing
MUSE2API_PUBLIC_BASE=

# Path to the Chromium browser executable
# On Linux/Docker this is usually /usr/bin/chromium or /usr/bin/chromium-browser
# When running locally on Windows, set it to the full Chrome path or leave empty for auto-detection
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP remote debugging port
MUSE2API_CDP_PORT=19210

# Task timeouts (in seconds)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Maximum number of concurrent generation tasks (can be raised freely according to server resources; default 2)
MUSE2API_CONCURRENCY=2

# Whether to run automatic keep-alive for accounts disabled in the admin console (0=off, 1=on)
# When on, disabled accounts still get silent keep-alive and session renewal, but are not routed for normal generation or chat
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0
